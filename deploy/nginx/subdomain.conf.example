# Copy to a new sites-available file for each system.
# Replace both placeholders. Do not enable this example directly.
server {
    listen 80;
    listen [::]:80;
    server_name SUBDOMAIN.DOMAIN;
    client_max_body_size 2m;
    location / {
        proxy_pass http://127.0.0.1:LOCAL_PORT;
        include /etc/nginx/snippets/platform-proxy.conf;
    }
}
